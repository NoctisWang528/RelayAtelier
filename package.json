{
  "name": "relay-atelier",
  "version": "1.1.1",
  "description": "A local, read-only kinetic observatory for coding agents",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "web": "node server/web.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/verify-ui.mjs",
    "package:mac": "electron-builder --mac dir",
    "package:win": "electron-builder --win zip --x64",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "capture:scenes": "node scripts/capture-scenes.mjs",
    "record:demo": "node scripts/record-demo.mjs"
  },
  "build": {
    "appId": "local.relay.atelier",
    "productName": "Relay Atelier",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "server/**",
      "src/**",
      "index.html",
      "package.json",
      "assets/**",
      "README.md",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "docs/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": "dir",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": "zip",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "extraMetadata": {
      "author": "Relay Atelier",
      "license": "MIT"
    }
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.65.1"
  }
}
